{
  "schema": "ark.agent-profile.v1",
  "profile_version": "1.2.0",
  "template_version": "1.2.0",
  "description": "NoahsArk 智能体实例配置：既是 schema（fields），也是可复制的默认实例（default）与按角色的预设（roles）。值里不允许出现任何凭据。",
  "default": {
    "schema": "ark.agent-profile.v1",
    "agent_name": "方舟节点执行",
    "role": "node-executor",
    "description": "节点执行智能体：在指定节点上跑任务、采集证据并回执，不碰设备独占测试",
    "instructions_ref": "noahsark-agent-template.md",
    "runtime": {
      "runtime_id": "<node>",
      "model": "<workspace-model>",
      "max_concurrent_tasks": 2,
      "timeout_minutes": 120
    },
    "paths": {
      "task_root_windows": "D:\\zhsh\\workspace\\tasks",
      "task_root_linux": "/home/zhsh/workspace/tasks",
      "task_dir_pattern": "<tasks-id>",
      "task_id_source": "multica-issue-id-first",
      "subdirs": ["assets", "work", "logs", "result", "receipts"],
      "root_files": ["plan.md", "manifest.json"],
      "on_violation": "BLOCKED_WORKDIR_POLICY"
    },
    "sources": {
      "git": {
        "canonical_repo": "zjashanda/ark-node",
        "ssh_alias": "github-zjashanda",
        "workflow": "branch-and-pull-request",
        "push_to_main": "forbidden-without-approval"
      },
      "skillhub": {
        "manifest": "manifests/canonical.json",
        "tool": "skillhub-sync",
        "sync_mode": "on-demand",
        "protect_local_drift": true
      }
    },
    "storage": {
      "root": "/srv/storage/ark",
      "results": "/srv/storage/ark/results/<node>/<project>/<run_id>",
      "receipts": "/srv/storage/ark/receipts/<node>/<project>/<run_id>",
      "artifacts": "/srv/storage/ark/artifacts",
      "quarantine": "/srv/storage/ark/_quarantine"
    },
    "time": {
      "display_format": "YYYY-MM-DD HH:MM:SS",
      "stamp_format": "YYYYMMDD-HHMMSS",
      "locale_zone": "Beijing",
      "offset_hours": 8,
      "zone_designator": "forbidden",
      "raw_field_prefix": "raw_"
    },
    "env_keys": [
      "GITHUB_TOKEN",
      "ACCESS_KEY_ID",
      "ACCESS_KEY_SECRET",
      "LSTTS_TTS_TOKEN",
      "EMAIL_PASSWORD",
      "NAS_ACCOUNT",
      "NAS_PASSWORD",
      "STORAGE_HOST",
      "STORAGE_USER",
      "STORAGE_PASSWORD"
    ],
    "loop": ["ark-dispatch", "execute", "ark-archive", "receipt", "ark-kb", "next-dispatch"],
    "supervision": {
      "rules": ["EXECUTION_CHECK", "PROGRESS_5M", "STATE_DRIFT", "RUNNING_NO_EVIDENCE"],
      "progress_interval_minutes": 5,
      "background_and_yield": "forbidden"
    },
    "execution_channel": {
      "mode": "hidden-background",
      "no_visible_terminal": true,
      "non_interactive": true,
      "stdout_redirect": "logs/",
      "stderr_redirect": "logs/",
      "forbidden_launchers": [
        "Start-Process",
        "Win32_Process.Create",
        "conhost",
        "wt",
        "powershell -NoExit"
      ],
      "require_batch_mode": true,
      "unverifiable_action": "BLOCKED_EXECUTION_CHANNEL",
      "background_and_yield": "forbidden"
    },
    "approval": {
      "requires": ["git-push", "external-publish", "real-device-action", "file-deletion", "permission-change"],
      "default_mode": "dry-run"
    },
    "receipts": {
      "run": "run.receipt.v1",
      "onboarding": "ark.agent-onboarding.v1"
    },
    "run_state": {
      "schema": "ark.run-state.v1",
      "schema_ref": "run-state.v1.json",
      "event_log": "receipts/events/gates-<YYYYMMDD>.jsonl",
      "stage_index": "receipts/stage-index.json",
      "events": ["EXECUTION_CHECK", "PROGRESS_5M", "STAGE_FINISHED", "BLOCKED", "FINAL_RECEIPT"],
      "blocker_codes": [
        "BLOCKED_SOURCE_MISSING",
        "BLOCKED_EXECUTION_CHANNEL",
        "BLOCKED_WORKDIR_POLICY",
        "BLOCKED_APPROVAL_REQUIRED",
        "BLOCKED_PLAN_INCOMPLETE"
      ],
      "run_statuses": [
        "queued",
        "dispatched",
        "running",
        "waiting_local_directory",
        "completed",
        "failed",
        "cancelled"
      ],
      "done_by": "human-only",
      "landing_status": "in_review"
    },
    "stage_policy": {
      "id_source": "multica-stage-integer",
      "milestone": "not-supported",
      "barrier": "--until-children-done --stage N",
      "rollback": "per-stage",
      "delete_evidence": "forbidden"
    },
    "gate_events": {
      "write_before_work": true,
      "progress_interval_minutes": 5,
      "missing_event": "BLOCKED",
      "watchdog_channels": ["comment", "run_record", "artifact_mtime"]
    },
    "receipt_layers": {
      "formal": "receipts/run.receipt.json",
      "candidate": "receipts/candidates/",
      "evidence_gap": "receipts/evidence-gaps/",
      "join_key": "run_id",
      "reflow_source": "formal-only",
      "schema_change": "forbidden"
    },
    "compatibility": {
      "template_version": "1.2.0",
      "ark_node": ">=0.1.0",
      "skillhub_sync": ">=1.0.0",
      "asset_tools": ">=0.1.0"
    }
  },
  "roles": {
    "coordinator": {
      "label": "协调者",
      "purpose": "拆解任务、派发子 issue、汇总验收",
      "max_concurrent_tasks": 3,
      "may_touch_devices": false,
      "may_change_node_config": false,
      "default_description": "协调智能体：拆任务、派 issue、对回执做验收，不直接操作设备"
    },
    "node-executor": {
      "label": "节点执行者",
      "purpose": "在具体节点上执行任务、采集证据、归档",
      "max_concurrent_tasks": 2,
      "may_touch_devices": false,
      "may_change_node_config": false,
      "default_description": "节点执行智能体：在指定节点上跑任务、采集证据并回执，不碰设备独占测试"
    },
    "hardware-bench": {
      "label": "硬件台架",
      "purpose": "真机与台架执行，独占设备",
      "max_concurrent_tasks": 1,
      "may_touch_devices": true,
      "may_change_node_config": false,
      "default_description": "硬件台架智能体：独占设备跑真机测试，产出可追溯证据与失败归因"
    },
    "knowledge-curator": {
      "label": "知识管理员",
      "purpose": "把执行结果沉淀为可复用知识条目",
      "max_concurrent_tasks": 2,
      "may_touch_devices": false,
      "may_change_node_config": false,
      "default_description": "知识管理智能体：把回执沉淀为 bug / knowledge / method / run 条目，不改执行结论"
    }
  },
  "fields": {
    "schema": { "type": "string", "required": true, "const": "ark.agent-profile.v1" },
    "agent_name": {
      "type": "string",
      "required": true,
      "pattern": "^方舟\\S+$",
      "description": "方舟+角色；不含任务名与时间戳"
    },
    "role": {
      "type": "string",
      "required": true,
      "enum": ["coordinator", "node-executor", "hardware-bench", "knowledge-curator"]
    },
    "description": {
      "type": "string",
      "required": true,
      "max_length": 120,
      "description": "一句话定位，用于列表展示与任务路由"
    },
    "instructions_ref": {
      "type": "string",
      "required": true,
      "description": "行为契约文件名；契约正文来自模板"
    },
    "runtime.runtime_id": { "type": "string", "required": true },
    "runtime.model": { "type": "string", "required": true },
    "runtime.max_concurrent_tasks": {
      "type": "integer",
      "required": true,
      "minimum": 1,
      "maximum": 3,
      "rule": "hardware-bench 必须为 1"
    },
    "runtime.timeout_minutes": { "type": "integer", "required": false, "minimum": 1 },
    "paths.task_root_windows": { "type": "string", "required": true, "const": "D:\\zhsh\\workspace\\tasks" },
    "paths.task_root_linux": { "type": "string", "required": true, "const": "/home/zhsh/workspace/tasks" },
    "paths.task_dir_pattern": { "type": "string", "required": true, "const": "<tasks-id>" },
    "paths.task_id_source": { "type": "string", "required": true, "const": "multica-issue-id-first" },
    "paths.subdirs": {
      "type": "array",
      "required": true,
      "items_const": ["assets", "work", "logs", "result", "receipts"]
    },
    "paths.root_files": {
      "type": "array",
      "required": true,
      "items_const": ["plan.md", "manifest.json"]
    },
    "paths.on_violation": { "type": "string", "required": true, "const": "BLOCKED_WORKDIR_POLICY" },
    "sources.git.canonical_repo": { "type": "string", "required": true },
    "sources.git.ssh_alias": { "type": "string", "required": true },
    "sources.git.workflow": { "type": "string", "required": true, "const": "branch-and-pull-request" },
    "sources.git.push_to_main": {
      "type": "string",
      "required": true,
      "const": "forbidden-without-approval"
    },
    "sources.skillhub.manifest": { "type": "string", "required": true },
    "sources.skillhub.tool": { "type": "string", "required": true, "const": "skillhub-sync" },
    "sources.skillhub.sync_mode": { "type": "string", "required": true, "enum": ["on-demand"] },
    "sources.skillhub.protect_local_drift": { "type": "boolean", "required": true },
    "storage.root": { "type": "string", "required": true, "const": "/srv/storage/ark" },
    "storage.results": { "type": "string", "required": true },
    "storage.receipts": { "type": "string", "required": true },
    "storage.artifacts": { "type": "string", "required": true },
    "storage.quarantine": { "type": "string", "required": true },
    "time.display_format": {
      "type": "string",
      "required": true,
      "const": "YYYY-MM-DD HH:MM:SS",
      "rule": "北京时间、无时区标记"
    },
    "time.stamp_format": { "type": "string", "required": true, "const": "YYYYMMDD-HHMMSS" },
    "time.locale_zone": { "type": "string", "required": true, "const": "Beijing" },
    "time.offset_hours": { "type": "integer", "required": true, "const": 8 },
    "time.zone_designator": { "type": "string", "required": true, "const": "forbidden" },
    "time.raw_field_prefix": { "type": "string", "required": true, "const": "raw_" },
    "env_keys": {
      "type": "array",
      "required": true,
      "items_pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "只允许键名，绝不含值"
    },
    "loop": {
      "type": "array",
      "required": true,
      "items_const": ["ark-dispatch", "execute", "ark-archive", "receipt", "ark-kb", "next-dispatch"]
    },
    "supervision.rules": {
      "type": "array",
      "required": true,
      "items_const": ["EXECUTION_CHECK", "PROGRESS_5M", "STATE_DRIFT", "RUNNING_NO_EVIDENCE"]
    },
    "supervision.progress_interval_minutes": { "type": "integer", "required": true, "const": 5 },
    "supervision.background_and_yield": { "type": "string", "required": true, "const": "forbidden" },
    "execution_channel.mode": { "type": "string", "required": true, "const": "hidden-background" },
    "execution_channel.no_visible_terminal": { "type": "boolean", "required": true, "const": true },
    "execution_channel.non_interactive": { "type": "boolean", "required": true, "const": true },
    "execution_channel.stdout_redirect": { "type": "string", "required": true, "const": "logs/" },
    "execution_channel.stderr_redirect": { "type": "string", "required": true, "const": "logs/" },
    "execution_channel.forbidden_launchers": {
      "type": "array",
      "required": true,
      "items_const": ["Start-Process", "Win32_Process.Create", "conhost", "wt", "powershell -NoExit"]
    },
    "execution_channel.require_batch_mode": { "type": "boolean", "required": true, "const": true },
    "execution_channel.unverifiable_action": { "type": "string", "required": true, "const": "BLOCKED_EXECUTION_CHANNEL" },
    "execution_channel.background_and_yield": { "type": "string", "required": true, "const": "forbidden" },
    "approval.requires": {
      "type": "array",
      "required": true,
      "items_const": [
        "git-push",
        "external-publish",
        "real-device-action",
        "file-deletion",
        "permission-change"
      ]
    },
    "approval.default_mode": { "type": "string", "required": true, "const": "dry-run" },
    "receipts.run": { "type": "string", "required": true, "const": "run.receipt.v1" },
    "receipts.onboarding": { "type": "string", "required": true, "const": "ark.agent-onboarding.v1" },
    "run_state.schema": { "type": "string", "required": true, "const": "ark.run-state.v1" },
    "run_state.schema_ref": { "type": "string", "required": true, "const": "run-state.v1.json" },
    "run_state.event_log": { "type": "string", "required": true, "const": "receipts/events/gates-<YYYYMMDD>.jsonl" },
    "run_state.stage_index": { "type": "string", "required": true, "const": "receipts/stage-index.json" },
    "run_state.events": {
      "type": "array",
      "required": true,
      "items_const": ["EXECUTION_CHECK", "PROGRESS_5M", "STAGE_FINISHED", "BLOCKED", "FINAL_RECEIPT"]
    },
    "run_state.blocker_codes": {
      "type": "array",
      "required": true,
      "items_const": [
        "BLOCKED_SOURCE_MISSING",
        "BLOCKED_EXECUTION_CHANNEL",
        "BLOCKED_WORKDIR_POLICY",
        "BLOCKED_APPROVAL_REQUIRED",
        "BLOCKED_PLAN_INCOMPLETE"
      ]
    },
    "run_state.run_statuses": {
      "type": "array",
      "required": true,
      "items_const": [
        "queued",
        "dispatched",
        "running",
        "waiting_local_directory",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "run_state.done_by": { "type": "string", "required": true, "const": "human-only" },
    "run_state.landing_status": { "type": "string", "required": true, "const": "in_review" },
    "stage_policy.id_source": { "type": "string", "required": true, "const": "multica-stage-integer" },
    "stage_policy.milestone": { "type": "string", "required": true, "const": "not-supported" },
    "stage_policy.barrier": { "type": "string", "required": true, "const": "--until-children-done --stage N" },
    "stage_policy.rollback": { "type": "string", "required": true, "const": "per-stage" },
    "stage_policy.delete_evidence": { "type": "string", "required": true, "const": "forbidden" },
    "gate_events.write_before_work": { "type": "boolean", "required": true, "const": true },
    "gate_events.progress_interval_minutes": { "type": "integer", "required": true, "const": 5 },
    "gate_events.missing_event": { "type": "string", "required": true, "const": "BLOCKED" },
    "gate_events.watchdog_channels": {
      "type": "array",
      "required": true,
      "items_const": ["comment", "run_record", "artifact_mtime"]
    },
    "receipt_layers.formal": { "type": "string", "required": true, "const": "receipts/run.receipt.json" },
    "receipt_layers.candidate": { "type": "string", "required": true, "const": "receipts/candidates/" },
    "receipt_layers.evidence_gap": { "type": "string", "required": true, "const": "receipts/evidence-gaps/" },
    "receipt_layers.join_key": { "type": "string", "required": true, "const": "run_id" },
    "receipt_layers.reflow_source": { "type": "string", "required": true, "const": "formal-only" },
    "receipt_layers.schema_change": { "type": "string", "required": true, "const": "forbidden" },
    "compatibility.template_version": { "type": "string", "required": true },
    "compatibility.ark_node": { "type": "string", "required": true },
    "compatibility.skillhub_sync": { "type": "string", "required": false },
    "compatibility.asset_tools": { "type": "string", "required": false }
  }
}

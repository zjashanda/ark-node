{
  "schema": "ark.agent-profile.v1",
  "profile_version": "1.7.0",
  "template_version": "1.7.0",
  "description": "NoahsArk 智能体实例配置：既是 schema（fields），也是可复制的默认实例（default）与按角色的预设（roles）。值里不允许出现任何凭据。",
  "default": {
    "schema": "ark.agent-profile.v1",
    "agent_name": "方舟节点执行",
    "role": "node-executor",
    "description": "节点执行智能体：在指定节点上跑任务、采集证据并回执，不碰设备独占测试",
    "instructions_ref": "noahsark-agent-template.md",
    "runtime": {
      "runtime_id": "<node>",
      "model": "<workspace-model>",
      "max_concurrent_tasks": 2,
      "timeout_minutes": 120,
      "node_binding": "<node>"
    },
    "paths": {
      "task_root_windows": "D:\\zhsh\\workspace\\tasks",
      "task_root_linux": "/home/zhsh/workspace/tasks",
      "task_dir_pattern": "<tasks-id>",
      "task_id_source": "multica-issue-id-first",
      "subdirs": [
        "assets",
        "work",
        "logs",
        "result",
        "receipts"
      ],
      "root_files": [
        "plan.md",
        "manifest.json"
      ],
      "on_violation": "BLOCKED_WORKDIR_POLICY"
    },
    "sources": {
      "git": {
        "canonical_repo": "zjashanda/ark-node",
        "ssh_alias": "github-zjashanda",
        "workflow": "branch-and-pull-request",
        "push_to_main": "forbidden-without-approval"
      },
      "skillhub": {
        "manifest": "manifests/canonical.json",
        "tool": "skillhub-sync",
        "sync_mode": "on-demand",
        "protect_local_drift": true
      }
    },
    "storage": {
      "root": "/srv/storage/ark",
      "results": "/srv/storage/ark/results/<node>/<project>/<run_id>",
      "receipts": "/srv/storage/ark/receipts/<node>/<project>/<run_id>",
      "artifacts": "/srv/storage/ark/artifacts",
      "quarantine": "/srv/storage/ark/_quarantine"
    },
    "time": {
      "display_format": "YYYY-MM-DD HH:MM:SS",
      "stamp_format": "YYYYMMDD-HHMMSS",
      "locale_zone": "Beijing",
      "offset_hours": 8,
      "zone_designator": "forbidden",
      "raw_field_prefix": "raw_"
    },
    "env_keys": [
      "GITHUB_TOKEN",
      "ACCESS_KEY_ID",
      "ACCESS_KEY_SECRET",
      "LSTTS_TTS_TOKEN",
      "EMAIL_PASSWORD",
      "NAS_ACCOUNT",
      "NAS_PASSWORD",
      "STORAGE_HOST",
      "STORAGE_USER",
      "STORAGE_PASSWORD"
    ],
    "loop": [
      "ark-dispatch",
      "execute",
      "ark-archive",
      "receipt",
      "ark-kb",
      "next-dispatch"
    ],
    "supervision": {
      "rules": [
        "EXECUTION_CHECK",
        "PROGRESS_5M",
        "STATE_DRIFT",
        "RUNNING_NO_EVIDENCE"
      ],
      "progress_interval_minutes": 5,
      "background_and_yield": "forbidden"
    },
    "execution_channel": {
      "mode": "hidden-background",
      "no_visible_terminal": true,
      "non_interactive": true,
      "stdout_redirect": "logs/",
      "stderr_redirect": "logs/",
      "forbidden_launchers": [
        "Start-Process",
        "Win32_Process.Create",
        "conhost",
        "wt",
        "powershell -NoExit"
      ],
      "require_batch_mode": true,
      "unverifiable_action": "BLOCKED_EXECUTION_CHANNEL",
      "background_and_yield": "forbidden",
      "launch_record": "logs/launch.json"
    },
    "approval": {
      "requires": [
        "git-push",
        "external-publish",
        "real-device-action",
        "file-deletion",
        "permission-change"
      ],
      "default_mode": "dry-run"
    },
    "receipts": {
      "run": "run.receipt.v1",
      "onboarding": "ark.agent-onboarding.v1"
    },
    "run_state": {
      "schema": "ark.run-state.v1",
      "schema_ref": "run-state.v1.json",
      "event_log": "receipts/events/gates-<YYYYMMDD>.jsonl",
      "stage_index": "receipts/stage-index.json",
      "events": [
        "EXECUTION_CHECK",
        "PROGRESS_5M",
        "STAGE_FINISHED",
        "BLOCKED",
        "FINAL_RECEIPT"
      ],
      "blocker_codes": [
        "BLOCKED_SOURCE_MISSING",
        "BLOCKED_EXECUTION_CHANNEL",
        "BLOCKED_WORKDIR_POLICY",
        "BLOCKED_APPROVAL_REQUIRED",
        "BLOCKED_PLAN_INCOMPLETE"
      ],
      "run_statuses": [
        "queued",
        "dispatched",
        "running",
        "waiting_local_directory",
        "completed",
        "failed",
        "cancelled"
      ],
      "done_by": "human-only",
      "landing_status": "in_review",
      "preflight_checks": [
        "runtime_online",
        "agent_runtime_match",
        "workdir_policy",
        "plan_present",
        "launcher_available",
        "hidden_execution_capable",
        "device_preflight"
      ]
    },
    "stage_policy": {
      "id_source": "multica-stage-integer",
      "milestone": "not-supported",
      "barrier": "--until-children-done --stage N",
      "rollback": "per-stage",
      "delete_evidence": "forbidden"
    },
    "gate_events": {
      "write_before_work": true,
      "progress_interval_minutes": 5,
      "missing_event": "BLOCKED",
      "watchdog_channels": [
        "comment",
        "run_record",
        "artifact_mtime"
      ],
      "watchdog_sample_seconds_min": 10,
      "watchdog_sample_seconds_max": 30
    },
    "receipt_layers": {
      "formal": "receipts/run.receipt.json",
      "candidate": "receipts/candidates/",
      "evidence_gap": "receipts/evidence-gaps/",
      "join_key": "run_id",
      "reflow_source": "formal-only",
      "schema_change": "forbidden"
    },
    "kb_sync": {
      "enabled": true,
      "context_schema": "ark.kb-context.v1",
      "delivery_schema": "ark.delivery.v1",
      "query_command": "python3 <ark-kb>/tools/kb.py query --json",
      "query_dims": [
        "capability",
        "project",
        "device",
        "firmware",
        "profile"
      ],
      "record_first": false,
      "refresh_points": [
        "stage_boundary",
        "every_30_minutes",
        "every_100_rounds",
        "registry_commit_change"
      ],
      "delivery_path": "receipts/delivery.json",
      "order": [
        "manifest",
        "receipt",
        "archive",
        "kb_record",
        "kb_query_back"
      ],
      "query_back_top": 20,
      "no_kb_required_reasons": [
        "no-new-knowledge",
        "pure-inventory",
        "duplicate-of-existing:<entry_id>",
        "sensitive-not-indexable"
      ],
      "incomplete_code": "DELIVERY_INCOMPLETE",
      "layers": {
        "formal": "receipts/run.receipt.json",
        "candidate": "receipts/candidates/",
        "evidence_gap": "receipts/evidence-gaps/"
      },
      "candidate_may_drive_dispatch": false,
      "checkpoint": {
        "event_schema": "ark.checkpoint.v1",
        "wal": "receipts/outbox/checkpoints-<YYYYMMDD>.jsonl",
        "index": "receipts/outbox/outbox.json",
        "append_only": true,
        "idempotency_key": "sha256(issue_id|run_id|stage|event_seq|evidence_digest)"
      },
      "triggers": [
        "EXECUTION_CHECK",
        "STAGE_FINISHED",
        "BLOCKED",
        "FAIL",
        "NEEDS_REVIEW",
        "WATCHDOG_RUNNING_NO_EVIDENCE",
        "WATCHDOG_STATE_DRIFT",
        "WATCHDOG_TIMEOUT",
        "WATCHDOG_HEARTBEAT_LOST",
        "MANUAL_CANCEL",
        "RUNTIME_CRASH",
        "RECOVERY_REPLAY"
      ],
      "final_receipt_role": "aggregate-close-only",
      "quality_tiers": {
        "formal": "evidence-complete",
        "candidate": "evidence-incomplete",
        "evidence_gap": "no-evidence"
      },
      "failure_can_be_formal": true,
      "failure_outcome_forbidden": "PASS",
      "scopes": [
        "run",
        "node",
        "project",
        "device_family",
        "platform",
        "capability",
        "global"
      ],
      "scope_inherit": "near-to-far",
      "cross_scope_reference": "derived_from-applies_to-exceptions",
      "project_may_override_global": false,
      "promotion": {
        "min_projects": 2,
        "promote_to": [
          "capability",
          "global"
        ],
        "requires_review": true,
        "demotion": "add-applies_to-or-exceptions"
      },
      "outbox_close_when": "all archive ok and kb ingest recorded-or-skipped and query-back pass-or-deferred",
      "recovery_scan": true,
      "recovery_scan_when": "run-start",
      "query_back_per_checkpoint": true
    },
    "tts_library": {
      "root": "/srv/storage/ark/artifacts/audio/tts-library",
      "index": "index.json",
      "canonical_tool": "asset-tools",
      "lookup_command": "asset-tools tts-library lookup --spec <spec.json>",
      "fetch_command": "asset-tools tts-library fetch --spec <spec.json> --dest assets/tts/original --task-dir .",
      "publish_command": "asset-tools tts-library publish --staging <dir> --task-dir .",
      "synth_tool": "tts-runtime",
      "synth_engine": "lstts",
      "lookup_before_synth": true,
      "reuse_requires": [
        "quality=formal",
        "status=active",
        "shareable=true",
        "full_cache_key_match",
        "sha256_verified",
        "acl_allowed"
      ],
      "original_dir": "assets/tts/original",
      "derived_dir": "work/audio",
      "hardlink_forbidden": true,
      "derived_requires_asset_id": true,
      "outbox_dir": "receipts/outbox",
      "unreachable_action": "BLOCKED_TTS_LIBRARY_UNREACHABLE",
      "sensitive_default_shareable": false,
      "gc_requires_approval": true
    },
    "compatibility": {
      "template_version": "1.7.0",
      "ark_node": ">=0.1.0",
      "skillhub_sync": ">=1.0.0",
      "asset_tools": ">=0.1.0"
    },
    "identity": {
      "role_family": "node-executor",
      "official_role": "node-executor",
      "avatar_icon": "⚙️",
      "avatar_policy": "stable-role-mapping"
    }
  },
  "roles": {
    "coordinator": {
      "label": "协调者",
      "purpose": "拆解任务、派发子 issue、汇总验收",
      "max_concurrent_tasks": 3,
      "may_touch_devices": false,
      "may_change_node_config": false,
      "default_description": "协调智能体：拆任务、派 issue、对回执做验收，不直接操作设备",
      "role_family": "coordinator",
      "avatar_icon": "🧭"
    },
    "node-executor": {
      "label": "节点执行者",
      "purpose": "在具体节点上执行任务、采集证据、归档",
      "max_concurrent_tasks": 2,
      "may_touch_devices": false,
      "may_change_node_config": false,
      "default_description": "节点执行智能体：在指定节点上跑任务、采集证据并回执，不碰设备独占测试",
      "role_family": "node-executor",
      "avatar_icon": "⚙️"
    },
    "hardware-bench": {
      "label": "硬件台架",
      "purpose": "真机与台架执行，独占设备",
      "max_concurrent_tasks": 1,
      "may_touch_devices": true,
      "may_change_node_config": false,
      "default_description": "硬件台架智能体：独占设备跑真机测试，产出可追溯证据与失败归因",
      "role_family": "hardware-bench",
      "avatar_icon": "🔧"
    },
    "knowledge-curator": {
      "label": "知识管理员",
      "purpose": "把执行结果沉淀为可复用知识条目",
      "max_concurrent_tasks": 2,
      "may_touch_devices": false,
      "may_change_node_config": false,
      "default_description": "知识管理智能体：把回执沉淀为 bug / knowledge / method / run 条目，不改执行结论",
      "role_family": "knowledge-curator",
      "avatar_icon": "📚"
    },
    "jinyiwei": {
      "label": "锦衣卫",
      "purpose": "只在绑定节点执行 Mika/Issue 派发的具体执行、测试、调试和验证任务",
      "role_family": "node-executor",
      "avatar_icon": "🛡️",
      "name_pattern": "^锦衣卫·\\S+(?:·[1-9]\\d*)?$",
      "default_model": "listenai/deepseek-flash",
      "max_concurrent_tasks": 1,
      "runtime_binding": "required-exact",
      "accepted_dispatchers": [
        "Mika",
        "Issue"
      ],
      "forbidden_scopes": [
        "planning",
        "coordination",
        "cross-node",
        "general-purpose"
      ],
      "may_touch_devices": false,
      "may_change_node_config": false,
      "default_description": "节点专属执行智能体：仅在绑定节点执行 Mika/Issue 派发的具体任务并回执"
    }
  },
  "fields": {
    "schema": {
      "type": "string",
      "required": true,
      "const": "ark.agent-profile.v1"
    },
    "agent_name": {
      "type": "string",
      "required": true,
      "pattern": "^(?:方舟\\S+|锦衣卫·\\S+(?:·[1-9]\\d*)?)$",
      "description": "方舟+角色，或锦衣卫·节点名（同节点多 runtime 用稳定数字后缀）；不含任务名、时间戳、provider 或模型名"
    },
    "role": {
      "type": "string",
      "required": true,
      "enum": [
        "coordinator",
        "node-executor",
        "hardware-bench",
        "knowledge-curator",
        "jinyiwei"
      ]
    },
    "description": {
      "type": "string",
      "required": true,
      "max_length": 120,
      "description": "一句话定位，用于列表展示与任务路由"
    },
    "instructions_ref": {
      "type": "string",
      "required": true,
      "description": "行为契约文件名；契约正文来自模板"
    },
    "runtime.runtime_id": {
      "type": "string",
      "required": true
    },
    "runtime.model": {
      "type": "string",
      "required": true
    },
    "runtime.max_concurrent_tasks": {
      "type": "integer",
      "required": true,
      "minimum": 1,
      "maximum": 3,
      "rule": "hardware-bench 与 jinyiwei 必须为 1；锦衣卫仅在节点 profile 明确放宽时例外"
    },
    "runtime.timeout_minutes": {
      "type": "integer",
      "required": false,
      "minimum": 1
    },
    "paths.task_root_windows": {
      "type": "string",
      "required": true,
      "const": "D:\\zhsh\\workspace\\tasks"
    },
    "paths.task_root_linux": {
      "type": "string",
      "required": true,
      "const": "/home/zhsh/workspace/tasks"
    },
    "paths.task_dir_pattern": {
      "type": "string",
      "required": true,
      "const": "<tasks-id>"
    },
    "paths.task_id_source": {
      "type": "string",
      "required": true,
      "const": "multica-issue-id-first"
    },
    "paths.subdirs": {
      "type": "array",
      "required": true,
      "items_const": [
        "assets",
        "work",
        "logs",
        "result",
        "receipts"
      ]
    },
    "paths.root_files": {
      "type": "array",
      "required": true,
      "items_const": [
        "plan.md",
        "manifest.json"
      ]
    },
    "paths.on_violation": {
      "type": "string",
      "required": true,
      "const": "BLOCKED_WORKDIR_POLICY"
    },
    "sources.git.canonical_repo": {
      "type": "string",
      "required": true
    },
    "sources.git.ssh_alias": {
      "type": "string",
      "required": true
    },
    "sources.git.workflow": {
      "type": "string",
      "required": true,
      "const": "branch-and-pull-request"
    },
    "sources.git.push_to_main": {
      "type": "string",
      "required": true,
      "const": "forbidden-without-approval"
    },
    "sources.skillhub.manifest": {
      "type": "string",
      "required": true
    },
    "sources.skillhub.tool": {
      "type": "string",
      "required": true,
      "const": "skillhub-sync"
    },
    "sources.skillhub.sync_mode": {
      "type": "string",
      "required": true,
      "enum": [
        "on-demand"
      ]
    },
    "sources.skillhub.protect_local_drift": {
      "type": "boolean",
      "required": true
    },
    "storage.root": {
      "type": "string",
      "required": true,
      "const": "/srv/storage/ark"
    },
    "storage.results": {
      "type": "string",
      "required": true
    },
    "storage.receipts": {
      "type": "string",
      "required": true
    },
    "storage.artifacts": {
      "type": "string",
      "required": true
    },
    "storage.quarantine": {
      "type": "string",
      "required": true
    },
    "time.display_format": {
      "type": "string",
      "required": true,
      "const": "YYYY-MM-DD HH:MM:SS",
      "rule": "北京时间、无时区标记"
    },
    "time.stamp_format": {
      "type": "string",
      "required": true,
      "const": "YYYYMMDD-HHMMSS"
    },
    "time.locale_zone": {
      "type": "string",
      "required": true,
      "const": "Beijing"
    },
    "time.offset_hours": {
      "type": "integer",
      "required": true,
      "const": 8
    },
    "time.zone_designator": {
      "type": "string",
      "required": true,
      "const": "forbidden"
    },
    "time.raw_field_prefix": {
      "type": "string",
      "required": true,
      "const": "raw_"
    },
    "env_keys": {
      "type": "array",
      "required": true,
      "items_pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "只允许键名，绝不含值"
    },
    "loop": {
      "type": "array",
      "required": true,
      "items_const": [
        "ark-dispatch",
        "execute",
        "ark-archive",
        "receipt",
        "ark-kb",
        "next-dispatch"
      ]
    },
    "supervision.rules": {
      "type": "array",
      "required": true,
      "items_const": [
        "EXECUTION_CHECK",
        "PROGRESS_5M",
        "STATE_DRIFT",
        "RUNNING_NO_EVIDENCE"
      ]
    },
    "supervision.progress_interval_minutes": {
      "type": "integer",
      "required": true,
      "const": 5
    },
    "supervision.background_and_yield": {
      "type": "string",
      "required": true,
      "const": "forbidden"
    },
    "execution_channel.mode": {
      "type": "string",
      "required": true,
      "const": "hidden-background"
    },
    "execution_channel.no_visible_terminal": {
      "type": "boolean",
      "required": true,
      "const": true
    },
    "execution_channel.non_interactive": {
      "type": "boolean",
      "required": true,
      "const": true
    },
    "execution_channel.stdout_redirect": {
      "type": "string",
      "required": true,
      "const": "logs/"
    },
    "execution_channel.stderr_redirect": {
      "type": "string",
      "required": true,
      "const": "logs/"
    },
    "execution_channel.forbidden_launchers": {
      "type": "array",
      "required": true,
      "items_const": [
        "Start-Process",
        "Win32_Process.Create",
        "conhost",
        "wt",
        "powershell -NoExit"
      ]
    },
    "execution_channel.require_batch_mode": {
      "type": "boolean",
      "required": true,
      "const": true
    },
    "execution_channel.unverifiable_action": {
      "type": "string",
      "required": true,
      "const": "BLOCKED_EXECUTION_CHANNEL"
    },
    "execution_channel.background_and_yield": {
      "type": "string",
      "required": true,
      "const": "forbidden"
    },
    "approval.requires": {
      "type": "array",
      "required": true,
      "items_const": [
        "git-push",
        "external-publish",
        "real-device-action",
        "file-deletion",
        "permission-change"
      ]
    },
    "approval.default_mode": {
      "type": "string",
      "required": true,
      "const": "dry-run"
    },
    "receipts.run": {
      "type": "string",
      "required": true,
      "const": "run.receipt.v1"
    },
    "receipts.onboarding": {
      "type": "string",
      "required": true,
      "const": "ark.agent-onboarding.v1"
    },
    "run_state.schema": {
      "type": "string",
      "required": true,
      "const": "ark.run-state.v1"
    },
    "run_state.schema_ref": {
      "type": "string",
      "required": true,
      "const": "run-state.v1.json"
    },
    "run_state.event_log": {
      "type": "string",
      "required": true,
      "const": "receipts/events/gates-<YYYYMMDD>.jsonl"
    },
    "run_state.stage_index": {
      "type": "string",
      "required": true,
      "const": "receipts/stage-index.json"
    },
    "run_state.events": {
      "type": "array",
      "required": true,
      "items_const": [
        "EXECUTION_CHECK",
        "PROGRESS_5M",
        "STAGE_FINISHED",
        "BLOCKED",
        "FINAL_RECEIPT"
      ]
    },
    "run_state.blocker_codes": {
      "type": "array",
      "required": true,
      "items_const": [
        "BLOCKED_SOURCE_MISSING",
        "BLOCKED_EXECUTION_CHANNEL",
        "BLOCKED_WORKDIR_POLICY",
        "BLOCKED_APPROVAL_REQUIRED",
        "BLOCKED_PLAN_INCOMPLETE"
      ]
    },
    "run_state.run_statuses": {
      "type": "array",
      "required": true,
      "items_const": [
        "queued",
        "dispatched",
        "running",
        "waiting_local_directory",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "run_state.done_by": {
      "type": "string",
      "required": true,

    {
      "id": "rules",
      "label": "硬规则",
      "summary": "以下规则对所有角色生效，全部出自模板正文对应章节；冲突时以模板正文为准。",
      "entries": [
        {
          "id": "rule.workdir",
          "kind": "rule",

{
  "schema": "ark.noahsark-index.catalog.v1",
  "name": "noahsark-index",
  "version": "1.7.0",
  "title": "NoahsArk 资源总览",
  "oss": {
    "bucket": "listenai-test-internal",
    "endpoint": "oss-cn-beijing.aliyuncs.com",
    "prefix": "noahsark",
    "visibility": "public-read"
  },
  "git": {
    "host": "github.com",
    "owner": "zjashanda",
    "repo": "zjashanda/ark-node",
    "source": "templates/noahsark-index"
  },
  "workdir": {
    "windows": "D:\\zhsh\\workspace\\tasks\\<tasks-id>\\",
    "linux": "/home/zhsh/workspace/tasks/<tasks-id>/"
  },
  "positioning": [
    "NoahsArk 是一个闭环平台，不是单个 Skill：任务拆解、真机执行、证据归档、知识回写由一组 Skill 与节点协作完成。",
    "Git 仓库是唯一真源；OSS 上的 noahsark/ 目录只是对外分发副本，全部内容由本仓库 templates/noahsark-index/ 生成，不手工维护。",
    "外部工作区只需要一个地址：noahsark/index.md。读完总览后按角色进入对应条目，不需要理解内部仓库结构。",
    "本目录的地址永久不变；更新只重新指向 index.md / index.json / manifest.json，已发布的版本目录不可修改。"
  ],
  "roles": [
    {
      "id": "external-reader",
      "label": "外部接入方",
      "summary": "在别的工作区首次接入 NoahsArk 的智能体：只读总览与模板，按规则建目录后即可开工。",
      "must_read": [
        "root.index-md",
        "agent-template.latest",
        "agent-template.template",
        "rule.execution_channel",
        "rule.workdir"
      ],
      "optional": [
        "root.index-json",
        "agent-template.profile",
        "rule.credentials"
      ]
    },
    {
      "id": "coordinator",
      "label": "协调者",
      "summary": "拆解任务、派发执行、汇总回执的调度型智能体。",
      "must_read": [
        "root.index-md",
        "agent-template.template",
        "rule.official-system",
        "rule.execution_channel",
        "rule.supervision",
        "rule.approval",
        "rule.credentials",
        "rule.time",
        "canonical.routing"
      ],
      "optional": [
        "canonical.skillhub",
        "git.ark-node",
        "git.ark-dispatch",
        "rule.workdir"
      ]
    },
    {
      "id": "node-executor",
      "label": "节点执行",
      "summary": "在具体机器上落地命令、同步环境、回收产物的执行型智能体。",
      "must_read": [
        "root.index-md",
        "agent-template.template",
        "rule.execution_channel",
        "rule.workdir",
        "rule.credentials",
        "rule.time",
        "canonical.node-cli"
      ],
      "optional": [
        "git.ark-node",
        "git.device-io",
        "canonical.skillhub",
        "canonical.routing"
      ]
    },
    {
      "id": "jinyiwei",
      "label": "锦衣卫",
      "summary": "绑定单一 runtime/节点，只执行 Mika/Issue 派发的具体执行、测试、调试和验证任务；统一图标 🥷。",
      "must_read": [
        "root.index-md",
        "agent-template.template",
        "agent-template.profile",
        "rule.official-system",
        "rule.jinyiwei",
        "rule.role-icons",
        "rule.execution_channel",
        "rule.workdir",
        "rule.supervision"
      ],
      "optional": [
        "canonical.node-cli",
        "git.ark-node",
        "rule.credentials",
        "rule.time"
      ]
    },
    {
      "id": "hardware-bench",
      "label": "真机基准",
      "summary": "跑烧录、播放、录音等真机验证的智能体；代码测试通过不等于真机通过。",
      "must_read": [
        "root.index-md",
        "agent-template.template",
        "rule.execution_channel",
        "rule.workdir",
        "rule.supervision",
        "git.lstest",
        "git.venusahisiburner"
      ],
      "optional": [
        "git.device-io",
        "git.usb-tree",
        "git.clearusb",
        "git.audio-runtime",
        "git.tts-runtime"
      ]
    },
    {
      "id": "knowledge-curator",
      "label": "知识沉淀",
      "summary": "把执行证据整理成可检索知识、维护账本与归档的智能体。",
      "must_read": [
        "root.index-md",
        "agent-template.template",
        "rule.time",
        "rule.storage",
        "canonical.kb-ledger",
        "git.ark-archive"
      ],
      "optional": [
        "git.ark-kb",
        "git.asset-tools",
        "canonical.skillhub"
      ]
    }
  ],
  "groups": [
    {
      "id": "meta",
      "label": "根入口",
      "summary": "唯一对外地址与本目录的自描述文件。第一次进来先读 index.md。",
      "entries": [
        {
          "id": "root.index-md",
          "kind": "entry",
          "title": "总览（人读入口）",
          "status": "available",
          "version": "1.7.0",
          "roles": [
            "external-reader",
            "coordinator",
            "node-executor",
            "hardware-bench",
            "knowledge-curator",
            "jinyiwei"
          ],
          "requires": [],
          "oss": "noahsark/index.md",
          "summary": "平台定位、角色必读顺序、各组条目入口。地址永久固定，外部工作区只记这一个链接。"
        },
        {
          "id": "root.index-json",
          "kind": "entry",
          "title": "总览（机器读入口）",
          "status": "available",
          "version": "1.7.0",
          "roles": [
            "external-reader",
            "coordinator",
            "node-executor",
            "knowledge-curator"
          ],
          "requires": [
            "root.index-md"
          ],
          "oss": "noahsark/index.json",
          "summary": "逐条结构化导航：每条含 id、状态、版本、地址、校验值、适用角色与前置依赖，供智能体直接解析。"
        },
        {
          "id": "root.manifest",
          "kind": "entry",
          "title": "根清单",
          "status": "available",
          "version": "1.7.0",
          "roles": [
            "coordinator",
            "node-executor",
            "knowledge-curator"
          ],
          "requires": [
            "root.index-json"
          ],
          "oss": "noahsark/manifest.json",
          "summary": "根版本号、内容所在 Git 提交、index.md 与 index.json 的校验值和发布时间，用于判断本目录是否被改动。"
        }
      ]
    },

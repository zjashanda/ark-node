        },
        {
          "id": "agent-template.manifest",
          "kind": "entry",
          "title": "模板清单 v1.0.1（不可变）",
          "status": "available",
          "version": "1.0.1",
          "roles": [
            "external-reader",
            "coordinator",
            "node-executor",
            "knowledge-curator"
          ],
          "requires": [
            "agent-template.latest"
          ],
          "oss": "noahsark/agent-template/v1.0.1/manifest.json",
          "sha256": "71518f4eaea5f4baf68f4e2314728da676e42bf55c800a0ac9456e5ff1049238",
          "summary": "版本、兼容矩阵、三个文件的校验值与发布来源；引用版本时以本条为准。"
        },
        {
          "id": "agent-template.template",
          "kind": "entry",
          "title": "智能体模板正文 v1.0.1",
          "status": "available",
          "version": "1.0.1",
          "roles": [
            "external-reader",
            "coordinator",
            "node-executor",
            "hardware-bench",
            "knowledge-curator"
